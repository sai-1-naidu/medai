# Required for text chat and the recorded-audio transcription fallback.
GROQ_API_KEY=
# Groq chat-completions model. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b

# Required only when running the optional Pipecat WebRTC voice assistant.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional. Defaults to backend/medivoice.db when started from backend.
# DATABASE_URL=sqlite:///./medivoice.db

# FastAPI dashboard bind address and port; used by start_services.ps1.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Pipecat runner bind address and port.
PIPECAT_HOST=127.0.0.1
PIPECAT_PORT=7860

# Browser-visible Pipecat host and the runner's prebuilt client route.
PIPECAT_CLIENT_HOST=127.0.0.1
PIPECAT_CLIENT_PATH=/client/
